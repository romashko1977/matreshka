# ==========================================================
# Валькирия · frontend. Скопируйте в .env.local и отредактируйте.
# Здесь НЕТ и НЕ ДОЛЖНО БЫТЬ секретных ключей: всё, что начинается
# с VITE_, попадает в JS-бандл и видно в браузере.
# Ключи бирж хранятся только на backend (см. корневой .env.example).
# ==========================================================

# Источник данных:
#   auto — пробуем backend (GET /api/status), при недоступности включаем DEMO
#   live — только backend; при недоступности показываем ошибку подключения
#   demo — только встроенные демонстрационные данные (помечаются DEMO DATA)
VITE_DATA_MODE=auto

# Базовый URL REST API. Пусто = тот же origin (через dev-прокси Vite или nginx).
VITE_API_BASE=

# Базовый URL WebSocket. Пусто = тот же origin (ws:// или wss:// автоматически).
VITE_WS_BASE=

# Куда dev-сервер Vite проксирует /api и /ws
VITE_PROXY_TARGET=http://localhost:8000

# Таймаут REST-запросов, мс
VITE_API_TIMEOUT_MS=8000

# Через сколько секунд без обновлений данные считаются устаревшими
VITE_STALE_AFTER_SEC=15
