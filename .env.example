# ========================================
# MATRESHKA - Environment Configuration
# ========================================
# Copy this file to .env and fill in your values

# === App ===
MATRESHKA_DEBUG=false
MATRESHKA_SECRET_KEY=your-secret-key-here
MATRESHKA_LANGUAGE=ru

# === Database ===
MATRESHKA_DATABASE_URL=postgresql+asyncpg://matreshka:matreshka@db:5432/matreshka
MATRESHKA_REDIS_URL=redis://redis:6379/0

# === Exchange: Bybit ===
MATRESHKA_BYBIT_API_KEY=
MATRESHKA_BYBIT_API_SECRET=
MATRESHKA_BYBIT_TESTNET=true

# === Exchange: MEXC ===
MATRESHKA_MEXC_API_KEY=
MATRESHKA_MEXC_API_SECRET=

# === Exchange: Bitunix ===
MATRESHKA_BITUNIX_API_KEY=
MATRESHKA_BITUNIX_API_SECRET=

# === Exchange: Binance ===
MATRESHKA_BINANCE_API_KEY=
MATRESHKA_BINANCE_API_SECRET=

# === Data Providers ===
MATRESHKA_COINGLASS_API_KEY=
MATRESHKA_FPI_API_KEY=

# === AI Providers ===
MATRESHKA_OPENAI_API_KEY=
MATRESHKA_ANTHROPIC_API_KEY=
MATRESHKA_AI_PROVIDER=openai
MATRESHKA_AI_MODEL=gpt-4o-mini

# === Telegram ===
MATRESHKA_TELEGRAM_BOT_TOKEN=
MATRESHKA_TELEGRAM_CHAT_ID=
MATRESHKA_TELEGRAM_ALERTS_ENABLED=true

# === Trading ===
MATRESHKA_TRADING_MODE=monitor
MATRESHKA_FUSION_MODE=weighted_vote
MATRESHKA_MAX_CONCURRENT_POSITIONS=5
MATRESHKA_MAX_RISK_PER_TRADE=0.02
MATRESHKA_MAX_DAILY_LOSS=0.05
MATRESHKA_DEFAULT_LEVERAGE=5
